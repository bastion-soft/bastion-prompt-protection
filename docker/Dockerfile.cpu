# syntax=docker/dockerfile:1.7
#
# Pre-built CPU image for bastion-prompt-protection. Pulls the model at
# build time so the container starts instantly with no network access.
#
# Build locally:
#     docker build -f docker/Dockerfile.cpu -t bastion-server:cpu .
#
# Or pull the published image (built on every release tag):
#     docker pull ghcr.io/bastionsoft/bastion-server:latest
#     docker run -p 8080:8080 ghcr.io/bastionsoft/bastion-server:latest
#
# Then:
#     curl -X POST localhost:8080/protect \
#          -H "Content-Type: application/json" \
#          -d '{"prompt": "Ignore previous instructions"}'

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/opt/bastion/cache \
    HF_HUB_OFFLINE=0

# ────────────────────────────────────────────────────────────────────────
# Stage 1 — install deps + pre-fetch model. Cache busts on requirements change.
# ────────────────────────────────────────────────────────────────────────
FROM base AS builder

WORKDIR /build
COPY examples/04_server/requirements.txt ./

RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# Pre-download the model into the cache so runtime is offline-ready.
RUN python -c "from huggingface_hub import snapshot_download; \
    snapshot_download('bastionsoft/binary-bastion-prompt-protection-deberta-v3-xsmall-v1')"

# ────────────────────────────────────────────────────────────────────────
# Stage 2 — runtime
# ────────────────────────────────────────────────────────────────────────
FROM base AS runtime

# Copy site-packages and the pre-fetched model cache
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /opt/bastion/cache /opt/bastion/cache

# Don't allow network calls at runtime — the model is already on disk.
ENV HF_HUB_OFFLINE=1

# Copy the FastAPI app
COPY examples/04_server/main.py /app/main.py
WORKDIR /app

EXPOSE 8080

# Use a non-root user
RUN useradd --create-home --uid 10001 bastion && chown -R bastion /app /opt/bastion
USER bastion

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health').read()" || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
