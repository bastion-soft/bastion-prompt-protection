# syntax=docker/dockerfile:1.7
#
# Pre-built GPU image for bastion-prompt-protection. Same FastAPI app as
# the CPU image, but bundled with onnxruntime-gpu and a CUDA-12 base for
# high-throughput workloads.
#
# Build locally:
#     docker build -f docker/Dockerfile.gpu -t bastion-prompt-protection:gpu .
#
# Or pull the published image (built on every release tag):
#     docker pull ghcr.io/bastion-soft/bastion-prompt-protection:latest-gpu
#     docker run --gpus all -p 8080:8080 ghcr.io/bastion-soft/bastion-prompt-protection:latest-gpu

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04 AS base

# OCI image labels — surface metadata on GHCR / Docker Hub package pages.
LABEL org.opencontainers.image.title="Bastion Prompt Protection (GPU)"
LABEL org.opencontainers.image.description="Self-hosted prompt-injection and jailbreak detector for LLM applications. GPU image (CUDA 12.4 + onnxruntime-gpu) with the Bastion Prompt Protection model and SDK baked in, for high-throughput workloads. Beats every open public baseline tested across four held-out benchmarks."
LABEL org.opencontainers.image.vendor="Bastion Soft"
LABEL org.opencontainers.image.source="https://github.com/bastion-soft/bastion-prompt-protection"
LABEL org.opencontainers.image.documentation="https://github.com/bastion-soft/bastion-prompt-protection#readme"
LABEL org.opencontainers.image.licenses="AGPL-3.0-or-later"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/opt/bastion/cache \
    HF_HUB_OFFLINE=0 \
    DEBIAN_FRONTEND=noninteractive

# Python 3.12 isn't in Ubuntu 22.04's default repos. The deadsnakes PPA is
# the standard way to get newer Python on Ubuntu LTS. We then create a
# venv at a known path so the runtime stage can copy it in one shot
# without guessing where pip dropped site-packages.
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common ca-certificates \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv python3.12-dev \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && ln -sf /usr/bin/python3.12 /usr/bin/python3

# All Python work happens inside this venv from here on. Single canonical
# location → simple multi-stage COPY in the runtime stage below.
ENV VIRTUAL_ENV=/opt/bastion/venv \
    PATH=/opt/bastion/venv/bin:$PATH
RUN python3.12 -m venv "$VIRTUAL_ENV" && pip install --upgrade pip

# ────────────────────────────────────────────────────────────────────────
# Stage 1 — install deps + pre-fetch model
# ────────────────────────────────────────────────────────────────────────
FROM base AS builder

WORKDIR /build
COPY examples/04_server/requirements.txt ./

# Swap in the GPU build of onnxruntime
RUN pip install -r requirements.txt \
    && pip uninstall -y onnxruntime \
    && pip install onnxruntime-gpu

# Pre-download the model. allow_patterns filters out files the SDK never
# loads (PyTorch safetensors, fp32 ONNX). Same logic as Dockerfile.cpu —
# see that file for the breakdown.
RUN python -c "from huggingface_hub import snapshot_download; \
    snapshot_download( \
        'bastionsoft/binary-bastion-prompt-protection-deberta-v3-xsmall-v1', \
        allow_patterns=[ \
            'onnx/model_quantized.onnx', \
            'tokenizer*', \
            'spm.model', \
            'special_tokens_map.json', \
            'config.json', \
            'temperature.json', \
            'labels.txt', \
        ], \
    )"

# ────────────────────────────────────────────────────────────────────────
# Stage 2 — runtime
# ────────────────────────────────────────────────────────────────────────
FROM base AS runtime

# One copy of the venv brings interpreter symlinks, pip-installed packages,
# and the bastion-server CLI binary all together.
COPY --from=builder /opt/bastion/venv /opt/bastion/venv
COPY --from=builder /opt/bastion/cache /opt/bastion/cache

ENV HF_HUB_OFFLINE=1

COPY examples/04_server/main.py /app/main.py
WORKDIR /app

EXPOSE 8080

RUN useradd --create-home --uid 10001 bastion && chown -R bastion /app /opt/bastion
USER bastion

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health').read()" || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
